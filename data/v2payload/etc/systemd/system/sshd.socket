# sshd-always-on.sh - remove with: sh sshd-always-on.sh remove (stock unit: /lib/systemd/system/sshd.socket)
[Unit]
Conflicts=sshd.service

[Socket]
RuntimeDirectory=sshd
ExecStartPre=/bin/mkdir -p /var/run/sshd
ListenStream=22
Accept=yes

[Install]
WantedBy=early.target sockets.target multi-user.target debug.target
